<?xml version="1.0" ?>
<robot name="facehugger">

  <!-- ===================== MATERIALS ===================== -->
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="leg">
    <color rgba="0.78 0.80 0.84 1.0"/>
  </material>

  <!-- ===================== BODY ===================== -->
  <link name="body">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.700"/>
      <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0018" iyz="0" izz="0.0045"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/QuadrupedBody.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.184 0.235 0.051"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FRONT LEFT LEG ==================== -->
  <!-- Shoulder joint: yaw (rotation around Z) -->
  <joint name="fl_shoulder_joint" type="revolute">
    <parent link="body"/>
    <child link="fl_shoulder"/>
    <origin xyz="-0.080 0.105 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="fl_shoulder">
    <inertial>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <mass value="0.082"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000015" iyz="0" izz="0.000015"/>
    </inertial>
    <visual>
      <!-- Shoulder segment from split leg assembly. Mesh +Y -> link -X. -->
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="meshes/leg_shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- Hip joint: pitch (rotation around Y) -->
  <joint name="fl_hip_joint" type="revolute">
    <parent link="fl_shoulder"/>
    <child link="fl_upper_leg"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="fl_upper_leg">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.092"/>
      <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
      <!-- Upper-leg segment. Offset +Z=0.080 shifts mesh Y=80 to link origin (hip). -->
      <origin xyz="0 0 0.080" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_upper.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.075"/>
      </geometry>
    </collision>
  </link>

  <!-- Knee joint: pitch (rotation around Y) -->
  <joint name="fl_knee_joint" type="revolute">
    <parent link="fl_upper_leg"/>
    <child link="fl_lower_leg"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="0.5" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="fl_lower_leg">
    <inertial>
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <mass value="0.092"/>
      <inertia ixx="0.000035" ixy="0" ixz="0" iyy="0.000035" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
      <!-- Lower-leg segment. Offset +Z=0.155 shifts mesh Y=155 to link origin (knee). -->
      <origin xyz="0 0 0.155" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_lower.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0387" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.020 0.0774"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.0774" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FRONT RIGHT LEG ==================== -->
  <joint name="fr_shoulder_joint" type="revolute">
    <parent link="body"/>
    <child link="fr_shoulder"/>
    <origin xyz="0.080 0.105 0.025" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="fr_shoulder">
    <inertial>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <mass value="0.082"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000015" iyz="0" izz="0.000015"/>
