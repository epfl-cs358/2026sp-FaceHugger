    </collision>
    <collision>
      <origin xyz="0 0 -0.0774" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== REAR LEFT LEG ==================== -->
