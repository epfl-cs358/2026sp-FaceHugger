      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.075"/>
      </geometry>
    </collision>
  </link>

  <joint name="fr_knee_joint" type="revolute">
    <parent link="fr_upper_leg"/>
    <child link="fr_lower_leg"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="0.5" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="fr_lower_leg">
    <inertial>
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <mass value="0.092"/>
      <inertia ixx="0.000035" ixy="0" ixz="0" iyy="0.000035" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
