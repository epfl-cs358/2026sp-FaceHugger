      </geometry>
    </collision>
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- ==================== REAR RIGHT LEG ==================== -->
  <joint name="rr_shoulder_joint" type="revolute">
    <parent link="body"/>
    <child link="rr_shoulder"/>
    <origin xyz="0.080 -0.105 0.025" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="rr_shoulder">
