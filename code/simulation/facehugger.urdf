    </collision>
  </link>

  <joint name="fr_foot_joint" type="fixed">
    <parent link="fr_lower_leg"/>
    <child link="fr_foot"/>
    <origin xyz="0 0 -0.090" rpy="0 0 0"/>
  </joint>
  <link name="fr_foot">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
    <collision>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- ==================== REAR LEFT LEG ==================== -->
  <joint name="rl_shoulder_joint" type="revolute">
    <parent link="body"/>
    <child link="rl_shoulder"/>
    <origin xyz="-0.080 -0.105 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="1.47" velocity="5.0"/>
  </joint>
  <link name="rl_shoulder">
    <inertial>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
